* text=auto

*.bat text eol=crlf
gradlew text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Versioned fixture bytes are hashed; keep them identical on every platform.
testdata/** text eol=lf

# Binary artifacts must never be line-ending normalized.
*.jar binary
*.apk binary
*.png binary
*.so binary
